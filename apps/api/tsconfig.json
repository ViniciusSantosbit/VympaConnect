{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "sourceMap": true,
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "esModuleInterop": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "test"]
}
