# Exclusivo do backend. Nunca usar VITE_* ou compartilhar esta URI.
# Copie para .env.supabase.local (ignorado). Substitua a senha com percent-encoding.
# Codifique apenas a senha, usando encodeURIComponent em ferramenta local segura.
# Sem parâmetros na URI: TLS é obrigatório e validado pelo driver pg.
DATABASE_URL=postgresql://USUARIO:SENHA_CODIFICADA@HOST:5432/postgres
# Opcional: certificado CA baixado nas configurações do Supabase; caminho relativo a apps/api.
SUPABASE_SSL_CA_FILE=
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
