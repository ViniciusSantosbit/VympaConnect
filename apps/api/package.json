{
  "name": "@vympa/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/database-command.mjs local dev",
    "build": "prisma generate && nest build",
    "start": "node scripts/database-command.mjs local start",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "npm run build && node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --runInBand",
    "db:generate": "node scripts/database-command.mjs local generate",
    "db:migrate": "node scripts/database-command.mjs local migrate",
    "db:deploy": "node scripts/database-command.mjs local deploy",
    "db:check": "node scripts/database-command.mjs local check",
    "db:validate": "node scripts/database-command.mjs local validate",
    "db:status": "node scripts/database-command.mjs local status",
    "db:supabase:check": "node scripts/database-command.mjs supabase check",
    "db:supabase:prepare": "node scripts/database-command.mjs supabase prepare",
    "start:supabase": "node scripts/database-command.mjs supabase start",
    "auth:configure-local": "node scripts/configure-local-auth.mjs",
    "auth:bootstrap-owner": "node scripts/auth-admin.mjs bootstrap-owner",
    "auth:recover-mfa": "node scripts/auth-admin.mjs recover-mfa",
    "test:integration:database": "node scripts/test-auth-database.mjs",
    "test:integration:prospecting": "node scripts/test-prospecting-database.mjs",
    "test:integration:clients-contracts": "node scripts/test-clients-contracts-database.mjs",
    "test:integration:goals": "node scripts/test-goals-database.mjs",
    "test:audit:goals": "node scripts/audit-prospecting.mjs --clients-contracts --goals",
    "test:audit:clients-contracts": "node scripts/audit-prospecting.mjs --finance --clients-contracts",
    "test:audit:prospecting": "node scripts/audit-prospecting.mjs",
    "test:audit:finance": "node scripts/audit-prospecting.mjs --finance",
    "test:integration:ai": "node scripts/test-ai-database.mjs"
  },
  "dependencies": {
    "@google/genai": "2.32.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.2.0",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.4",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@supabase/supabase-js": "2.118.0",
    "@vympa/shared": "0.1.0",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.9",
    "helmet": "8.3.0",
    "nestjs-pino": "5.3.1",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.10",
    "@nestjs/testing": "12.2.0",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "prisma": "7.10.1",
    "supertest": "7.3.1"
  }
}
