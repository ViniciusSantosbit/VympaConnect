generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "vympa_private"]
}

model SystemMetadata {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(100)
  value     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_metadata")
  @@schema("public")
}

enum AdminRole {
  OWNER
  ADMIN

  @@schema("vympa_private")
}

model AdminProfile {
  id                String               @id @default(uuid()) @db.Uuid
  identityId        String               @unique @map("identity_id") @db.Uuid
  email             String               @unique @db.VarChar(254)
  role              AdminRole            @default(ADMIN)
  active            Boolean              @default(true)
  recoveryRequired  Boolean              @default(false) @map("recovery_required")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  invitations       AdminInvitation[]
  auditEvents       AdminAuditEvent[]
  recoveryRequests  MfaRecoveryRequest[] @relation("RecoveryRequester")
  recoveryApprovals MfaRecoveryRequest[] @relation("RecoveryApprover")
  assignedLeads Lead[] @relation("LeadAssignee")
  createdLeads Lead[] @relation("LeadCreator")
  leadEvents LeadEvent[]
  placesUsage PlacesUsage[]
  proposalsCreated Proposal[] @relation("ProposalCreator")
  proposalsAssigned Proposal[] @relation("ProposalResponsible")
  financialEntries FinancialTransaction[]
  investments Investment[]
  financeAudits FinanceAuditEvent[]
  clients Client[]
  contracts Contract[]
  clientActivities ClientActivity[]
  contractHistory ContractStatusHistory[]
  contractAmendments ContractAmendment[]
  contractDocuments ContractDocument[]
  goalsCreated Goal[]
  goalAssignments GoalAssignment[]
  goalUpdates GoalManualUpdate[]
  goalActivities GoalActivity[]
  goalSnapshots GoalProgressSnapshot[]

  @@index([active, role])
  @@map("admin_profiles")
  @@schema("vympa_private")
}

model Goal {
 id String @id @default(uuid()) @db.Uuid
 requestKey String @unique @db.Uuid
 title String @db.VarChar(180)
 description String? @db.VarChar(3000)
 category String @db.VarChar(20)
 metric String @db.VarChar(40)
 mode String @db.VarChar(10)
 direction String @db.VarChar(15)
 unit String @db.VarChar(15)
 target Decimal @db.Decimal(24,4)
 baseline Decimal? @db.Decimal(24,4)
 startsOn DateTime @db.Date
 endsOn DateTime @db.Date
 priority String @default("MEDIUM") @db.VarChar(10)
 periodicity String @default("CUSTOM") @db.VarChar(15)
 segment LeadSegment?
 scope String @db.VarChar(15)
 adminVisible Boolean @default(false)
 allowManualUpdates Boolean @default(false)
 alertDays Int @default(7)
 notes String? @db.VarChar(3000)
 blocked Boolean @default(false)
 cancelledAt DateTime? @db.Timestamptz(3)
 version Int @default(1)
 createdById String @db.Uuid
 createdBy AdminProfile @relation(fields:[createdById],references:[id],onDelete:Restrict)
 assignments GoalAssignment[]
 updates GoalManualUpdate[]
 activities GoalActivity[]
 snapshots GoalProgressSnapshot[]
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 @@index([category,cancelledAt,endsOn])
 @@index([metric,startsOn,endsOn])
 @@map("goals")
 @@schema("vympa_private")
}
model GoalAssignment {
 goalId String @db.Uuid
 goal Goal @relation(fields:[goalId],references:[id],onDelete:Restrict)
 profileId String @db.Uuid
 profile AdminProfile @relation(fields:[profileId],references:[id],onDelete:Restrict)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@id([goalId,profileId])
 @@index([profileId])
 @@map("goal_assignments")
 @@schema("vympa_private")
}
model GoalManualUpdate {
 id String @id @default(uuid()) @db.Uuid
 requestKey String @unique @db.Uuid
 goalId String @db.Uuid
 goal Goal @relation(fields:[goalId],references:[id],onDelete:Restrict)
 actorId String @db.Uuid
 actor AdminProfile @relation(fields:[actorId],references:[id],onDelete:Restrict)
 value Decimal @db.Decimal(24,4)
 observedOn DateTime @db.Date
 reason String @db.VarChar(3000)
 goalVersion Int
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@index([goalId,observedOn,createdAt])
 @@map("goal_manual_updates")
 @@schema("vympa_private")
}
model GoalActivity {
 id String @id @default(uuid()) @db.Uuid
 goalId String @db.Uuid
 goal Goal @relation(fields:[goalId],references:[id],onDelete:Restrict)
 actorId String @db.Uuid
 actor AdminProfile @relation(fields:[actorId],references:[id],onDelete:Restrict)
 kind String @db.VarChar(40)
 body String @db.VarChar(3000)
 before Json?
 after Json?
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@index([goalId,createdAt])
 @@map("goal_activities")
 @@schema("vympa_private")
}
model GoalProgressSnapshot {
 id String @id @default(uuid()) @db.Uuid
 goalId String @db.Uuid
 goal Goal @relation(fields:[goalId],references:[id],onDelete:Restrict)
 actorId String @db.Uuid
 actor AdminProfile @relation(fields:[actorId],references:[id],onDelete:Restrict)
 goalVersion Int
 data Json
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@index([goalId,createdAt])
 @@map("goal_progress_snapshots")
 @@schema("vympa_private")
}

enum LeadStatus {
  NOT_CONTACTED
  CONTACTED
  NEGOTIATING
  WON
  LOST
  @@schema("vympa_private")
}

enum LeadSegment {
  ADVOCACIA
  CONTABILIDADE
  IMOBILIARIO
  @@schema("vympa_private")
}

model Lead {
  id String @id @default(uuid()) @db.Uuid
  // Informações próprias, inseridas manualmente; nenhum conteúdo Places é copiado.
  companyName String? @map("company_name") @db.VarChar(180)
  segment LeadSegment
  region String? @db.VarChar(20)
  state String? @db.VarChar(2)
  city String? @db.VarChar(100)
  email String? @db.VarChar(254)
  contactName String? @map("contact_name") @db.VarChar(150)
  contactChannel String? @map("contact_channel") @db.VarChar(180)
  status LeadStatus @default(NOT_CONTACTED)
  lossReason String? @map("loss_reason") @db.VarChar(1000)
  lastContactAt DateTime? @map("last_contact_at") @db.Timestamptz(3)
  nextAction String? @map("next_action") @db.VarChar(500)
  assigneeId String? @map("assignee_id") @db.Uuid
  assignee AdminProfile? @relation("LeadAssignee", fields:[assigneeId], references:[id], onDelete:Restrict)
  createdById String @map("created_by_id") @db.Uuid
  createdBy AdminProfile @relation("LeadCreator", fields:[createdById], references:[id], onDelete:Restrict)
  externalReference PlaceReference?
  events LeadEvent[]
  followUps LeadFollowUp[]
  proposals Proposal[]
  clientId String? @map("client_id") @db.Uuid
  client Client? @relation(fields:[clientId], references:[id], onDelete:Restrict, map:"leads_clientId_fkey")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@index([status, updatedAt])
  @@index([assigneeId, status])
  @@index([segment, state, city])
  @@index([clientId])
  @@map("leads")
  @@schema("vympa_private")
}

model PlaceReference {
  placeId String @id @map("place_id") @db.VarChar(2048)
  leadId String @unique @map("lead_id") @db.Uuid
  lead Lead @relation(fields:[leadId], references:[id], onDelete:Restrict)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@map("place_references")
  @@schema("vympa_private")
}

model LeadEvent {
  id String @id @default(uuid()) @db.Uuid
  leadId String @map("lead_id") @db.Uuid
  lead Lead @relation(fields:[leadId], references:[id], onDelete:Restrict)
  actorId String @map("actor_id") @db.Uuid
  actor AdminProfile @relation(fields:[actorId], references:[id], onDelete:Restrict)
  kind String @db.VarChar(30)
  body String? @db.VarChar(4000)
  channel String? @db.VarChar(40)
  previousStatus LeadStatus? @map("previous_status")
  newStatus LeadStatus? @map("new_status")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([leadId, createdAt])
  @@index([createdAt])
  @@map("lead_events")
  @@schema("vympa_private")
}

model LeadFollowUp {
  id String @id @default(uuid()) @db.Uuid
  leadId String @map("lead_id") @db.Uuid
  lead Lead @relation(fields:[leadId], references:[id], onDelete:Restrict)
  action String @db.VarChar(500)
  dueAt DateTime @map("due_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([leadId, dueAt])
  @@index([completedAt, dueAt])
  @@map("lead_follow_ups")
  @@schema("vympa_private")
}

model PlacesUsage {
  profileId String @map("profile_id") @db.Uuid
  profile AdminProfile @relation(fields:[profileId], references:[id], onDelete:Restrict)
  hour DateTime @db.Timestamptz(3)
  calls Int @default(0)
  details Int @default(0)
  @@id([profileId, hour])
  @@index([hour])
  @@map("places_usage")
  @@schema("vympa_private")
}

model AdminInvitation {
  id         String       @id @default(uuid()) @db.Uuid
  email      String       @db.VarChar(254)
  identityId String?      @map("identity_id") @db.Uuid
  role       AdminRole    @default(ADMIN)
  issuedById String       @map("issued_by_id") @db.Uuid
  issuedBy   AdminProfile @relation(fields: [issuedById], references: [id], onDelete: Restrict)
  expiresAt  DateTime     @map("expires_at") @db.Timestamptz(3)
  acceptedAt DateTime?    @map("accepted_at") @db.Timestamptz(3)
  revokedAt  DateTime?    @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([identityId, email, expiresAt])
  @@index([issuedById])
  @@map("admin_invitations")
  @@schema("vympa_private")
}

model AuthSession {
  id           String    @id @db.VarChar(64)
  identityId   String    @map("identity_id") @db.Uuid
  tokensCipher String    @map("tokens_cipher")
  csrfHash     String    @map("csrf_hash") @db.VarChar(64)
  recovery     Boolean   @default(false)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([identityId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
  @@schema("vympa_private")
}

model AdminAuditEvent {
  id        String        @id @default(uuid()) @db.Uuid
  actorId   String?       @map("actor_id") @db.Uuid
  actor     AdminProfile? @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action    String        @db.VarChar(80)
  targetId  String?       @map("target_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([actorId, createdAt])
  @@index([targetId, createdAt])
  @@map("admin_audit_events")
  @@schema("vympa_private")
}

model MfaRecoveryRequest {
  id            String        @id @default(uuid()) @db.Uuid
  identityId    String        @map("identity_id") @db.Uuid
  approvedById  String?       @map("approved_by_id") @db.Uuid
  approvedBy    AdminProfile? @relation("RecoveryApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  requester     AdminProfile  @relation("RecoveryRequester", fields: [identityId], references: [identityId], onDelete: Restrict)
  approvedAt    DateTime?     @map("approved_at") @db.Timestamptz(3)
  executedAt    DateTime?     @map("executed_at") @db.Timestamptz(3)
  caseReference String?       @map("case_reference") @db.VarChar(64)
  expiresAt     DateTime      @map("expires_at") @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([identityId, expiresAt])
  @@map("mfa_recovery_requests")
  @@schema("vympa_private")
}

model ServiceOffering {
 id String @id @default(uuid()) @db.Uuid
 code String @unique @db.VarChar(40)
 name String @db.VarChar(180)
 description String @db.VarChar(3000)
 baseCents Int?
 setupCents Int?
 monthlyCents Int?
 operatingCents Int?
 active Boolean @default(true)
 notes String? @db.VarChar(3000)
 version Int @default(1)
 priceHistory ServicePriceVersion[]
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 @@map("service_offerings")
 @@schema("vympa_private")
}
model ServicePriceVersion {
 id String @id @default(uuid()) @db.Uuid
 offeringId String @db.Uuid
 offering ServiceOffering @relation(fields:[offeringId],references:[id],onDelete:Restrict)
 version Int
 snapshot Json
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@unique([offeringId,version])
 @@map("service_price_versions")
 @@schema("vympa_private")
}
model DiscountPolicy {
 id String @id @default("default") @db.VarChar(32)
 rules Json
 provisional Boolean @default(true)
 version Int @default(1)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 @@map("discount_policies")
 @@schema("vympa_private")
}
enum ProposalStatus {
 DRAFT
 PREPARED
 SENT
 ACCEPTED
 REJECTED
 EXPIRED
 @@schema("vympa_private")
}
model Proposal {
 id String @id @default(uuid()) @db.Uuid
 companyName String @db.VarChar(180)
 segment LeadSegment
 leadId String? @db.Uuid
 lead Lead? @relation(fields:[leadId],references:[id],onDelete:Restrict)
 responsibleId String @db.Uuid
 responsible AdminProfile @relation("ProposalResponsible",fields:[responsibleId],references:[id],onDelete:Restrict)
 createdById String @db.Uuid
 createdBy AdminProfile @relation("ProposalCreator",fields:[createdById],references:[id],onDelete:Restrict)
 status ProposalStatus @default(DRAFT)
 version Int @default(1)
 simulationDate DateTime @db.Date
 input Json
 result Json
 versions ProposalVersion[]
 contracts Contract[]
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 @@index([status,updatedAt])
 @@index([leadId])
 @@index([responsibleId])
 @@map("proposals")
 @@schema("vympa_private")
}
model ProposalVersion {
 id String @id @default(uuid()) @db.Uuid
 proposalId String @db.Uuid
 proposal Proposal @relation(fields:[proposalId],references:[id],onDelete:Restrict)
 version Int
 snapshot Json
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@unique([proposalId,version])
 @@map("proposal_versions")
 @@schema("vympa_private")
}
enum FinancialType {
 INCOME
 EXPENSE
 @@schema("vympa_private")
}
enum FinancialStatus {
 PLANNED
 PENDING
 SETTLED
 CANCELLED
 @@schema("vympa_private")
}
enum FinancialGroup {
 GENERAL
 AI
 INFRA
 INVESTMENT
 @@schema("vympa_private")
}
model FinancialCategory {
 id String @id @default(uuid()) @db.Uuid
 name String @unique @db.VarChar(100)
 group FinancialGroup @default(GENERAL)
 active Boolean @default(true)
 version Int @default(1)
 entries FinancialTransaction[]
 recurring RecurringTransaction[]
 investments Investment[]
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 @@map("financial_categories")
 @@schema("vympa_private")
}
model FinancialTransaction {
 id String @id @default(uuid()) @db.Uuid
 requestKey String @unique @db.VarChar(100)
 description String @db.VarChar(250)
 type FinancialType
 amountCents Int
 competenceOn DateTime @db.Date
 dueOn DateTime? @db.Date
 settledOn DateTime? @db.Date
 status FinancialStatus
 categoryId String @db.Uuid
 category FinancialCategory @relation(fields:[categoryId],references:[id],onDelete:Restrict)
 categoryGroup FinancialGroup
 counterparty String? @db.VarChar(180)
 serviceReference String? @db.VarChar(180)
 paymentMethod String? @db.VarChar(100)
 notes String? @db.VarChar(3000)
 createdById String @db.Uuid
 createdBy AdminProfile @relation(fields:[createdById],references:[id],onDelete:Restrict)
 recurringId String? @db.Uuid
 recurring RecurringTransaction? @relation(fields:[recurringId],references:[id],onDelete:Restrict)
 recurrencePeriod String? @db.VarChar(7)
 investment Investment?
 aiCost AiCost?
 version Int @default(1)
 clientId String? @db.Uuid
 client Client? @relation(fields:[clientId],references:[id],onDelete:Restrict)
 contractId String? @db.Uuid
 contract Contract? @relation(fields:[contractId,clientId],references:[id,clientId],onDelete:Restrict)
 billingReference String? @unique @db.VarChar(100)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 @@unique([recurringId,recurrencePeriod])
 @@index([clientId,contractId])
 @@index([status,settledOn,type])
 @@index([competenceOn,categoryId])
 @@index([dueOn,status])
 @@map("financial_transactions")
 @@schema("vympa_private")
}

enum ClientStatus {
 PROSPECT
 ONBOARDING
 ACTIVE
 SUSPENDED
 INACTIVE
 @@schema("vympa_private")
}
enum ContractStatus {
 DRAFT
 PENDING_SIGNATURE
 SIGNED
 ACTIVE
 EXPIRED
 TERMINATED
 CANCELLED
 @@schema("vympa_private")
}
model Client {
 id String @id @default(uuid()) @db.Uuid
 companyName String @db.VarChar(180)
 tradeName String? @db.VarChar(180)
 cnpj String? @unique @db.VarChar(14)
 segment LeadSegment
 email String? @db.VarChar(254)
 phone String? @db.VarChar(40)
 website String? @db.VarChar(500)
 address String? @db.VarChar(500)
 city String? @db.VarChar(100)
 state String? @db.VarChar(2)
 postalCode String? @db.VarChar(8)
 responsibleId String @db.Uuid
 responsible AdminProfile @relation(fields:[responsibleId],references:[id],onDelete:Restrict)
 notes String? @db.VarChar(3000)
 status ClientStatus @default(PROSPECT)
 version Int @default(1)
 contacts ClientContact[]
 services ClientService[]
 leads Lead[]
 contracts Contract[]
 activities ClientActivity[]
 transactions FinancialTransaction[]
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 @@index([status,segment])
 @@index([responsibleId])
 @@map("clients")
 @@schema("vympa_private")
}
model ClientContact {
 id String @id @default(uuid()) @db.Uuid
 clientId String @db.Uuid
 client Client @relation(fields:[clientId],references:[id],onDelete:Restrict)
 name String @db.VarChar(150)
 position String? @db.VarChar(100)
 email String? @db.VarChar(254)
 phone String? @db.VarChar(40)
 preferredChannel String? @db.VarChar(30)
 notes String? @db.VarChar(1000)
 primary Boolean @default(false)
 version Int @default(1)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 @@index([clientId])
 @@map("client_contacts")
 @@schema("vympa_private")
}
model ClientService {
 id String @id @default(uuid()) @db.Uuid
 clientId String @db.Uuid
 client Client @relation(fields:[clientId],references:[id],onDelete:Restrict)
 code String @db.VarChar(40)
 status String @default("PLANNED") @db.VarChar(30)
 notes String? @db.VarChar(1000)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 @@unique([clientId,code])
 @@map("client_services")
 @@schema("vympa_private")
}
model ClientActivity {
 id String @id @default(uuid()) @db.Uuid
 clientId String @db.Uuid
 client Client @relation(fields:[clientId],references:[id],onDelete:Restrict)
 actorId String @db.Uuid
 actor AdminProfile @relation(fields:[actorId],references:[id],onDelete:Restrict)
 kind String @db.VarChar(50)
 body String @db.VarChar(3000)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@index([clientId,createdAt])
 @@map("client_activities")
 @@schema("vympa_private")
}
model Contract {
 id String @id @default(uuid()) @db.Uuid
 requestKey String @unique @db.VarChar(100)
 number String @unique @db.VarChar(60)
 clientId String @db.Uuid
 client Client @relation(fields:[clientId],references:[id],onDelete:Restrict)
 title String @db.VarChar(180)
 description String? @db.VarChar(3000)
 responsibleId String @db.Uuid
 responsible AdminProfile @relation(fields:[responsibleId],references:[id],onDelete:Restrict)
 startsOn DateTime? @db.Date
 endsOn DateTime? @db.Date
 setupCents Int?
 monthlyCents Int?
 billingPeriod String @default("MONTHLY") @db.VarChar(20)
 commercialTerms String? @db.VarChar(3000)
 adjustmentTerms String? @db.VarChar(3000)
 notes String? @db.VarChar(3000)
 status ContractStatus @default(DRAFT)
 signatureEvidence String? @db.VarChar(1000)
 proposalId String? @db.Uuid
 proposal Proposal? @relation(fields:[proposalId],references:[id],onDelete:Restrict)
 proposalSnapshot Json?
 renewedFromId String? @unique @db.Uuid
 renewedFrom Contract? @relation("Renewal",fields:[renewedFromId],references:[id],onDelete:Restrict)
 renewal Contract? @relation("Renewal")
 services ContractService[]
 documents ContractDocument[]
 amendments ContractAmendment[]
 history ContractStatusHistory[]
 transactions FinancialTransaction[]
 version Int @default(1)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 @@unique([id,clientId])
 @@index([clientId,status])
 @@index([status,endsOn])
 @@index([responsibleId])
 @@map("contracts")
 @@schema("vympa_private")
}
model ContractService {
 id String @id @default(uuid()) @db.Uuid
 contractId String @db.Uuid
 contract Contract @relation(fields:[contractId],references:[id],onDelete:Restrict)
 code String @db.VarChar(40)
 @@unique([contractId,code])
 @@map("contract_services")
 @@schema("vympa_private")
}
model ContractDocument {
 id String @id @default(uuid()) @db.Uuid
 contractId String @db.Uuid
 contract Contract @relation(fields:[contractId],references:[id],onDelete:Restrict)
 name String @db.VarChar(180)
 kind String @db.VarChar(10)
 actorId String @db.Uuid
 actor AdminProfile @relation(fields:[actorId],references:[id],onDelete:Restrict)
 storageStatus String @default("PENDING_PRIVATE_STORAGE") @db.VarChar(40)
 amendments ContractAmendment[]
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@index([contractId])
 @@map("contract_documents")
 @@schema("vympa_private")
}
model ContractAmendment {
 id String @id @default(uuid()) @db.Uuid
 contractId String @db.Uuid
 contract Contract @relation(fields:[contractId],references:[id],onDelete:Restrict)
 requestKey String @unique @db.VarChar(100)
 previousMonthlyCents Int
 monthlyCents Int
 effectiveOn DateTime @db.Date
 reason String @db.VarChar(3000)
 indexName String? @db.VarChar(100)
 percentBps Int?
 documentId String? @db.Uuid
 document ContractDocument? @relation(fields:[documentId],references:[id],onDelete:Restrict)
 actorId String @db.Uuid
 actor AdminProfile @relation(fields:[actorId],references:[id],onDelete:Restrict)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@unique([contractId,effectiveOn])
 @@map("contract_amendments")
 @@schema("vympa_private")
}
model ContractStatusHistory {
 id String @id @default(uuid()) @db.Uuid
 contractId String @db.Uuid
 contract Contract @relation(fields:[contractId],references:[id],onDelete:Restrict)
 actorId String @db.Uuid
 actor AdminProfile @relation(fields:[actorId],references:[id],onDelete:Restrict)
 kind String @db.VarChar(50)
 reason String @db.VarChar(3000)
 before Json?
 after Json
