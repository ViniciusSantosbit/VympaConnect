generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "vympa_private"]
}

model SystemMetadata {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(100)
  value     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_metadata")
  @@schema("public")
}

enum AdminRole {
  OWNER
  ADMIN

  @@schema("vympa_private")
}

model AdminProfile {
  id                String               @id @default(uuid()) @db.Uuid
  identityId        String               @unique @map("identity_id") @db.Uuid
  email             String               @unique @db.VarChar(254)
  role              AdminRole            @default(ADMIN)
  active            Boolean              @default(true)
  recoveryRequired  Boolean              @default(false) @map("recovery_required")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  invitations       AdminInvitation[]
  auditEvents       AdminAuditEvent[]
  recoveryRequests  MfaRecoveryRequest[] @relation("RecoveryRequester")
  recoveryApprovals MfaRecoveryRequest[] @relation("RecoveryApprover")
  assignedLeads Lead[] @relation("LeadAssignee")
  createdLeads Lead[] @relation("LeadCreator")
  leadEvents LeadEvent[]
  placesUsage PlacesUsage[]
  proposalsCreated Proposal[] @relation("ProposalCreator")
  proposalsAssigned Proposal[] @relation("ProposalResponsible")
  financialEntries FinancialTransaction[]
  investments Investment[]
  financeAudits FinanceAuditEvent[]

  @@index([active, role])
  @@map("admin_profiles")
  @@schema("vympa_private")
}

enum LeadStatus {
  NOT_CONTACTED
  CONTACTED
  NEGOTIATING
  WON
  LOST
  @@schema("vympa_private")
}

enum LeadSegment {
  ADVOCACIA
  CONTABILIDADE
  IMOBILIARIO
  @@schema("vympa_private")
}

model Lead {
  id String @id @default(uuid()) @db.Uuid
  // Informações próprias, inseridas manualmente; nenhum conteúdo Places é copiado.
  companyName String? @map("company_name") @db.VarChar(180)
  segment LeadSegment
  region String? @db.VarChar(20)
  state String? @db.VarChar(2)
  city String? @db.VarChar(100)
  email String? @db.VarChar(254)
  contactName String? @map("contact_name") @db.VarChar(150)
  contactChannel String? @map("contact_channel") @db.VarChar(180)
  status LeadStatus @default(NOT_CONTACTED)
  lossReason String? @map("loss_reason") @db.VarChar(1000)
  lastContactAt DateTime? @map("last_contact_at") @db.Timestamptz(3)
  nextAction String? @map("next_action") @db.VarChar(500)
  assigneeId String? @map("assignee_id") @db.Uuid
  assignee AdminProfile? @relation("LeadAssignee", fields:[assigneeId], references:[id], onDelete:Restrict)
  createdById String @map("created_by_id") @db.Uuid
  createdBy AdminProfile @relation("LeadCreator", fields:[createdById], references:[id], onDelete:Restrict)
  externalReference PlaceReference?
  events LeadEvent[]
  followUps LeadFollowUp[]
  proposals Proposal[]
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@index([status, updatedAt])
  @@index([assigneeId, status])
  @@index([segment, state, city])
  @@map("leads")
  @@schema("vympa_private")
}

model PlaceReference {
  placeId String @id @map("place_id") @db.VarChar(2048)
  leadId String @unique @map("lead_id") @db.Uuid
  lead Lead @relation(fields:[leadId], references:[id], onDelete:Restrict)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@map("place_references")
  @@schema("vympa_private")
}

model LeadEvent {
  id String @id @default(uuid()) @db.Uuid
  leadId String @map("lead_id") @db.Uuid
  lead Lead @relation(fields:[leadId], references:[id], onDelete:Restrict)
  actorId String @map("actor_id") @db.Uuid
  actor AdminProfile @relation(fields:[actorId], references:[id], onDelete:Restrict)
  kind String @db.VarChar(30)
  body String? @db.VarChar(4000)
  channel String? @db.VarChar(40)
  previousStatus LeadStatus? @map("previous_status")
  newStatus LeadStatus? @map("new_status")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([leadId, createdAt])
  @@index([createdAt])
  @@map("lead_events")
  @@schema("vympa_private")
}

model LeadFollowUp {
  id String @id @default(uuid()) @db.Uuid
  leadId String @map("lead_id") @db.Uuid
  lead Lead @relation(fields:[leadId], references:[id], onDelete:Restrict)
  action String @db.VarChar(500)
  dueAt DateTime @map("due_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([leadId, dueAt])
  @@index([completedAt, dueAt])
  @@map("lead_follow_ups")
  @@schema("vympa_private")
}

model PlacesUsage {
  profileId String @map("profile_id") @db.Uuid
  profile AdminProfile @relation(fields:[profileId], references:[id], onDelete:Restrict)
  hour DateTime @db.Timestamptz(3)
  calls Int @default(0)
  details Int @default(0)
  @@id([profileId, hour])
  @@index([hour])
  @@map("places_usage")
  @@schema("vympa_private")
}

model AdminInvitation {
  id         String       @id @default(uuid()) @db.Uuid
  email      String       @db.VarChar(254)
  identityId String?      @map("identity_id") @db.Uuid
  role       AdminRole    @default(ADMIN)
  issuedById String       @map("issued_by_id") @db.Uuid
  issuedBy   AdminProfile @relation(fields: [issuedById], references: [id], onDelete: Restrict)
  expiresAt  DateTime     @map("expires_at") @db.Timestamptz(3)
  acceptedAt DateTime?    @map("accepted_at") @db.Timestamptz(3)
  revokedAt  DateTime?    @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([identityId, email, expiresAt])
  @@index([issuedById])
  @@map("admin_invitations")
  @@schema("vympa_private")
}

model AuthSession {
  id           String    @id @db.VarChar(64)
  identityId   String    @map("identity_id") @db.Uuid
  tokensCipher String    @map("tokens_cipher")
  csrfHash     String    @map("csrf_hash") @db.VarChar(64)
  recovery     Boolean   @default(false)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([identityId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
  @@schema("vympa_private")
}

model AdminAuditEvent {
  id        String        @id @default(uuid()) @db.Uuid
  actorId   String?       @map("actor_id") @db.Uuid
  actor     AdminProfile? @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action    String        @db.VarChar(80)
  targetId  String?       @map("target_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([actorId, createdAt])
  @@index([targetId, createdAt])
  @@map("admin_audit_events")
  @@schema("vympa_private")
}

model MfaRecoveryRequest {
  id            String        @id @default(uuid()) @db.Uuid
  identityId    String        @map("identity_id") @db.Uuid
  approvedById  String?       @map("approved_by_id") @db.Uuid
  approvedBy    AdminProfile? @relation("RecoveryApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  requester     AdminProfile  @relation("RecoveryRequester", fields: [identityId], references: [identityId], onDelete: Restrict)
  approvedAt    DateTime?     @map("approved_at") @db.Timestamptz(3)
  executedAt    DateTime?     @map("executed_at") @db.Timestamptz(3)
  caseReference String?       @map("case_reference") @db.VarChar(64)
  expiresAt     DateTime      @map("expires_at") @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([identityId, expiresAt])
  @@map("mfa_recovery_requests")
  @@schema("vympa_private")
}

model ServiceOffering {
 id String @id @default(uuid()) @db.Uuid
 code String @unique @db.VarChar(40)
 name String @db.VarChar(180)
 description String @db.VarChar(3000)
 baseCents Int?
 setupCents Int?
 monthlyCents Int?
 operatingCents Int?
 active Boolean @default(true)
 notes String? @db.VarChar(3000)
 version Int @default(1)
 priceHistory ServicePriceVersion[]
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 @@map("service_offerings")
 @@schema("vympa_private")
}
model ServicePriceVersion {
 id String @id @default(uuid()) @db.Uuid
 offeringId String @db.Uuid
 offering ServiceOffering @relation(fields:[offeringId],references:[id],onDelete:Restrict)
 version Int
 snapshot Json
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@unique([offeringId,version])
 @@map("service_price_versions")
 @@schema("vympa_private")
}
model DiscountPolicy {
 id String @id @default("default") @db.VarChar(32)
 rules Json
 provisional Boolean @default(true)
 version Int @default(1)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 @@map("discount_policies")
 @@schema("vympa_private")
}
enum ProposalStatus {
 DRAFT
 PREPARED
 SENT
 ACCEPTED
 REJECTED
 EXPIRED
 @@schema("vympa_private")
}
model Proposal {
 id String @id @default(uuid()) @db.Uuid
 companyName String @db.VarChar(180)
 segment LeadSegment
 leadId String? @db.Uuid
 lead Lead? @relation(fields:[leadId],references:[id],onDelete:Restrict)
 responsibleId String @db.Uuid
 responsible AdminProfile @relation("ProposalResponsible",fields:[responsibleId],references:[id],onDelete:Restrict)
 createdById String @db.Uuid
 createdBy AdminProfile @relation("ProposalCreator",fields:[createdById],references:[id],onDelete:Restrict)
 status ProposalStatus @default(DRAFT)
 version Int @default(1)
 simulationDate DateTime @db.Date
 input Json
 result Json
 versions ProposalVersion[]
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 @@index([status,updatedAt])
 @@index([leadId])
 @@index([responsibleId])
 @@map("proposals")
 @@schema("vympa_private")
}
model ProposalVersion {
 id String @id @default(uuid()) @db.Uuid
 proposalId String @db.Uuid
 proposal Proposal @relation(fields:[proposalId],references:[id],onDelete:Restrict)
 version Int
 snapshot Json
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@unique([proposalId,version])
 @@map("proposal_versions")
 @@schema("vympa_private")
}
enum FinancialType {
 INCOME
 EXPENSE
 @@schema("vympa_private")
}
enum FinancialStatus {
 PLANNED
 PENDING
 SETTLED
 CANCELLED
 @@schema("vympa_private")
}
enum FinancialGroup {
 GENERAL
 AI
 INFRA
 INVESTMENT
 @@schema("vympa_private")
}
model FinancialCategory {
 id String @id @default(uuid()) @db.Uuid
 name String @unique @db.VarChar(100)
 group FinancialGroup @default(GENERAL)
 active Boolean @default(true)
 version Int @default(1)
 entries FinancialTransaction[]
 recurring RecurringTransaction[]
 investments Investment[]
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 @@map("financial_categories")
 @@schema("vympa_private")
}
model FinancialTransaction {
 id String @id @default(uuid()) @db.Uuid
 requestKey String @unique @db.VarChar(100)
 description String @db.VarChar(250)
 type FinancialType
 amountCents Int
 competenceOn DateTime @db.Date
 dueOn DateTime? @db.Date
 settledOn DateTime? @db.Date
 status FinancialStatus
 categoryId String @db.Uuid
 category FinancialCategory @relation(fields:[categoryId],references:[id],onDelete:Restrict)
 categoryGroup FinancialGroup
 counterparty String? @db.VarChar(180)
 serviceReference String? @db.VarChar(180)
 paymentMethod String? @db.VarChar(100)
 notes String? @db.VarChar(3000)
 createdById String @db.Uuid
 createdBy AdminProfile @relation(fields:[createdById],references:[id],onDelete:Restrict)
 recurringId String? @db.Uuid
 recurring RecurringTransaction? @relation(fields:[recurringId],references:[id],onDelete:Restrict)
 recurrencePeriod String? @db.VarChar(7)
 investment Investment?
 aiCost AiCost?
 version Int @default(1)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 @@unique([recurringId,recurrencePeriod])
 @@index([status,settledOn,type])
 @@index([competenceOn,categoryId])
 @@index([dueOn,status])
 @@map("financial_transactions")
 @@schema("vympa_private")
}
model RecurringTransaction {
 id String @id @default(uuid()) @db.Uuid
 description String @db.VarChar(250)
 amountCents Int
 categoryId String @db.Uuid
 category FinancialCategory @relation(fields:[categoryId],references:[id],onDelete:Restrict)
 dueDay Int
 startsOn DateTime @db.Date
 endsOn DateTime? @db.Date
 supplier String? @db.VarChar(180)
 notes String? @db.VarChar(3000)
 active Boolean @default(true)
 version Int @default(1)
 entries FinancialTransaction[]
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 @@map("recurring_transactions")
 @@schema("vympa_private")
}
enum InvestmentStatus {
 PLANNED
 APPROVED
 PAID
 CANCELLED
 @@schema("vympa_private")
}
model Investment {
 id String @id @default(uuid()) @db.Uuid
 name String @db.VarChar(180)
 description String? @db.VarChar(3000)
 estimatedCents Int
 actualCents Int?
 priority String @db.VarChar(10)
 status InvestmentStatus @default(PLANNED)
 plannedOn DateTime @db.Date
 categoryId String @db.Uuid
 category FinancialCategory @relation(fields:[categoryId],references:[id],onDelete:Restrict)
 responsibleId String @db.Uuid
 responsible AdminProfile @relation(fields:[responsibleId],references:[id],onDelete:Restrict)
 transactionId String? @unique @db.Uuid
 transaction FinancialTransaction? @relation(fields:[transactionId],references:[id],onDelete:Restrict)
 notes String? @db.VarChar(3000)
 version Int @default(1)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 @@index([status,plannedOn])
 @@map("investments")
 @@schema("vympa_private")
}
model AiCost {
 id String @id @default(uuid()) @db.Uuid
 provider String @db.VarChar(100)
 modelService String @db.VarChar(180)
 amountCents Int
 period String @db.VarChar(7)
 projectReference String? @db.VarChar(180)
 unit String? @db.VarChar(80)
 quantity String? @db.VarChar(80)
 notes String? @db.VarChar(3000)
 transactionId String? @unique @db.Uuid
 transaction FinancialTransaction? @relation(fields:[transactionId],references:[id],onDelete:Restrict)
 version Int @default(1)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 @@index([period])
 @@map("ai_costs")
 @@schema("vympa_private")
}
model FinancialOpeningBalance {
 id String @id @default("default") @db.VarChar(32)
 amountCents Int
 effectiveOn DateTime @db.Date
 version Int @default(1)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 @@map("financial_opening_balances")
 @@schema("vympa_private")
}
model FinanceAuditEvent {
 id String @id @default(uuid()) @db.Uuid
 actorId String @db.Uuid
 actor AdminProfile @relation(fields:[actorId],references:[id],onDelete:Restrict)
 action String @db.VarChar(80)
 entityId String @db.VarChar(100)
 before Json?
 after Json
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@index([entityId,createdAt])
 @@index([actorId,createdAt])
 @@map("finance_audit_events")
 @@schema("vympa_private")
}
