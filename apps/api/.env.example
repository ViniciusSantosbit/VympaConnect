# Ambiente exclusivo da API e CLI Prisma, independente do diretório de execução.
# DATABASE_URL vem exclusivamente deste arquivo nos comandos locais.
# Somente desenvolvimento local; nunca apontar comandos locais para produção.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://vympa:local-development-only@localhost:5432/vympa_connect?schema=public
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info
# Geoapify: chave exclusiva de servidor, nunca usar em VITE_*.
GEOAPIFY_API_KEY=
GEOAPIFY_PLACES_ENABLED=false
# Integrações futuras opcionais.
ANTHROPIC_API_KEY=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
RESEND_API_KEY=
EMAIL_FROM=
REDIS_URL=redis://localhost:6379
# Autenticação: definir estratégia de sessão/MFA antes de configurar segredos.
AUTH_SESSION_SECRET=


# Auth local separado do PostgreSQL de aplicação. Copiar chaves do Supabase LOCAL somente neste .env.
AUTH_ENVIRONMENT=local
SUPABASE_AUTH_URL=http://127.0.0.1:54321
SUPABASE_AUTH_PUBLISHABLE_KEY=
SUPABASE_AUTH_SECRET_KEY=
# Gerar 32 bytes aleatórios em base64 localmente; nunca versionar a chave real.
AUTH_SESSION_ENCRYPTION_KEY=
AUTH_WEB_ORIGIN=http://127.0.0.1:5173
# Para staging: AUTH_ENVIRONMENT=isolated e confirmação exata do hostname; projeto principal bloqueado.
AUTH_ISOLATED_PROJECT_CONFIRMATION=
# Emergência offline do último OWNER: desativada por padrão. Exige verificação independente por dois operadores e incidente registrado.
AUTH_ENABLE_BREAK_GLASS=false

# VYMPA AI - habilitar somente após configurar a chave no backend
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
