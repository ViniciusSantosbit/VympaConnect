# Ambiente exclusivo da API e CLI Prisma, independente do diretório de execução.
# Variáveis do processo têm precedência. Migrations exigem DATABASE_URL explícita.
# Somente desenvolvimento local; nunca apontar comandos locais para produção.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://vympa:local-development-only@localhost:5432/vympa_connect?schema=public
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info
# Integrações futuras: opcionais, não carregadas nesta etapa.
GOOGLE_PLACES_API_KEY=
ANTHROPIC_API_KEY=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
RESEND_API_KEY=
EMAIL_FROM=
REDIS_URL=redis://localhost:6379
# Autenticação: definir estratégia de sessão/MFA antes de configurar segredos.
AUTH_SESSION_SECRET=

