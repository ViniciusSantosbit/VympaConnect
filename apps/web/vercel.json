{
  "buildCommand": "cd ../.. && npm run build -w @vympa/shared && npm run build -w @vympa/web",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://vympaconnect-api.vercel.app/api/:path*"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "installCommand": "HUSKY=0 npm ci --include=dev --workspaces --include-workspace-root"
}
